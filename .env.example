# Web app: optional LaTeX compiler service. Leave unset to use only the fast IR renderer; when the
# service is set but unavailable, the web app falls back to the fast renderer automatically.
COMPILER_SERVICE_URL=http://localhost:8080

# Compiler service (outside Docker; the compiler image sets both). TECTONIC_BIN must be a trusted
# Tectonic binary; TECTONIC_CACHE_DIR is optional and defaults to Tectonic's own cache location.
TECTONIC_BIN=/usr/local/bin/tectonic
TECTONIC_CACHE_DIR=/opt/tectonic-cache
